#!/bin/bash
# Claude Code Orchestra - Setup & Update
# Fetches template from remote and applies to current project.
#
# Usage:
#   orchestra-init                          # Setup/update with defaults
#   orchestra-init --ref v1.0               # Pin to specific version
#   ORCHESTRA_REPO=<url> orchestra-init     # Use custom repository

set -e

REPO_URL="${ORCHESTRA_REPO:-https://github.com/hira22/claude-code-orchestra}"
TARGET_REF=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            REPO_URL="$2"
            shift 2
            ;;
        --ref)
            TARGET_REF="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: orchestra-init [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --repo URL   Repository URL (default: \$ORCHESTRA_REPO or hira22/claude-code-orchestra)"
            echo "  --ref REF    Git ref to checkout (tag, branch, commit)"
            echo "  -h, --help   Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# jq availability check
if ! command -v jq &>/dev/null; then
    echo "⚠️  jq がインストールされていません。"
    echo "   既存の .claude/settings.json がある場合、マージではなくテンプレートで上書きされます。"
    echo "   マージ機能を使うには: brew install jq (macOS) / apt install jq (Linux)"
    JQ_AVAILABLE=false
else
    JQ_AVAILABLE=true
fi

echo "🎼 Claude Code Orchestra 環境を適用します..."
echo "→ リポジトリ: $REPO_URL"
[ -n "$TARGET_REF" ] && echo "→ バージョン: $TARGET_REF"

# Fetch template from remote
TMP_DIR=$(mktemp -d)
trap "rm -rf $TMP_DIR" EXIT

echo "→ テンプレートをダウンロード中..."
clone_args=(--depth 1)
[ -n "$TARGET_REF" ] && clone_args+=(--branch "$TARGET_REF")
git clone "${clone_args[@]}" "$REPO_URL" "$TMP_DIR" 2>/dev/null || {
    echo "エラー: リポジトリのクローンに失敗しました: $REPO_URL"
    exit 1
}

# settings.json merge function
merge_settings_json() {
    local existing="$1"
    local template="$2"
    local output="$3"

    jq -s '
        .[0] as $existing |
        .[1] as $template |

        def merge_hooks($a; $b):
            ($a // []) + ($b // []) | unique_by((.matcher // "") + (.hooks[0].command // ""));

        (($template // {}) | del(.hooks, .permissions, .env))
        * (($existing // {}) | del(.hooks, .permissions, .env))
        + {
            hooks: (
                (($existing.hooks // {}) | keys) + (($template.hooks // {}) | keys) | unique
                | reduce .[] as $key ({}; . + {
                    ($key): merge_hooks($existing.hooks[$key]; $template.hooks[$key])
                })
            ),
            permissions: {
                allow: (($existing.permissions.allow // []) + ($template.permissions.allow // [])) | unique,
                deny: (($existing.permissions.deny // []) + ($template.permissions.deny // [])) | unique,
                ask: ($existing.permissions.ask // []),
                defaultMode: ($existing.permissions.defaultMode // "default")
            },
            env: (($existing.env // {}) + ($template.env // {}))
        }
    ' "$existing" "$template" > "$output"
}

# Detect mode: initial setup vs update
if [ -d ".claude" ]; then
    # ─── Update mode ───
    echo ""
    echo "⚠️  既存の Orchestra 環境が検出されました。テンプレートで更新しますか？ (y/n)"
    read -r response
    if [ "$response" != "y" ]; then
        echo "→ キャンセルしました"
        exit 0
    fi

    # Update template-managed directories under .claude/
    for dir in skills hooks rules agents docs; do
        if [ -d "$TMP_DIR/.claude/$dir" ]; then
            cp -r "$TMP_DIR/.claude/$dir" .claude/
            echo "✓ .claude/$dir/ を更新しました"
        fi
    done

    # Merge settings.json
    if [ -f ".claude/settings.json" ] && [ -f "$TMP_DIR/.claude/settings.json" ]; then
        if [ "$JQ_AVAILABLE" = true ]; then
            echo "→ settings.json をマージ中..."
            merge_settings_json ".claude/settings.json" "$TMP_DIR/.claude/settings.json" ".claude/settings.json.tmp"
            mv ".claude/settings.json.tmp" ".claude/settings.json"
            echo "✓ settings.json をマージしました"
        else
            echo "⚠️  jq が無いためマージできません。テンプレートで上書きします。"
            cp "$TMP_DIR/.claude/settings.json" .claude/
            echo "✓ settings.json を上書きしました"
        fi
    elif [ -f "$TMP_DIR/.claude/settings.json" ] && [ ! -f ".claude/settings.json" ]; then
        cp "$TMP_DIR/.claude/settings.json" .claude/
        echo "✓ settings.json を作成しました"
    fi

    # Skip CLAUDE.md (user-managed)
    echo "→ CLAUDE.md はスキップしました（ユーザー管理）"

    # .codex/
    if [ -d ".codex" ]; then
        echo "⚠️  .codex/ を更新しますか？ (y/n)"
        read -r response
        if [ "$response" = "y" ]; then
            cp -r "$TMP_DIR/.codex" .
            echo "✓ .codex/ を更新しました"
        else
            echo "→ .codex/ をスキップしました"
        fi
    else
        cp -r "$TMP_DIR/.codex" .
        echo "✓ .codex/ を作成しました"
    fi

    # .gemini/
    if [ -d ".gemini" ]; then
        echo "⚠️  .gemini/ を更新しますか？ (y/n)"
        read -r response
        if [ "$response" = "y" ]; then
            cp -r "$TMP_DIR/.gemini" .
            echo "✓ .gemini/ を更新しました"
        else
            echo "→ .gemini/ をスキップしました"
        fi
    else
        cp -r "$TMP_DIR/.gemini" .
        echo "✓ .gemini/ を作成しました"
    fi

else
    # ─── Initial setup mode ───
    cp -r "$TMP_DIR/.claude" .
    echo "✓ .claude/ を作成しました"

    cp -r "$TMP_DIR/.codex" .
    echo "✓ .codex/ を作成しました"

    cp -r "$TMP_DIR/.gemini" .
    echo "✓ .gemini/ を作成しました"

    if [ -f "$TMP_DIR/CLAUDE.md" ] && [ ! -f "CLAUDE.md" ]; then
        cp "$TMP_DIR/CLAUDE.md" .
        echo "✓ CLAUDE.md を作成しました"
    fi
fi

echo ""
echo "🎉 Orchestra環境の適用が完了しました！"
echo ""

# Dynamic skill listing
echo "利用可能なスキル:"
echo ""
for skill_dir in .claude/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill_name=$(basename "$skill_dir")
    skill_file="$skill_dir/SKILL.md"
    [ -f "$skill_file" ] || continue
    description=$(awk '
        /^description:/ {
            sub(/^description:[[:space:]]*/, "")
            if ($0 == "|" || $0 == ">") { getline; sub(/^[[:space:]]+/, "") }
            print; exit
        }
    ' "$skill_file")
    printf "    /%-20s %s\n" "$skill_name" "$description"
done

echo ""
echo "claudeを起動して開始してください。"
